# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your keys:   cp .env.example .env
# ----------------------------------------------------------------------------

# REQUIRED to run agents. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Default model used by new agents (cheap + fast for demos).
DEFAULT_MODEL=claude-haiku-4-5-20251001

# ----------------------------------------------------------------------------
# Telegram channel (OPTIONAL but required for the messaging-channel demo).
# 1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
# 2. Paste the token it gives you below.
# 3. (Optional) set TELEGRAM_DEFAULT_TARGET to an agent or workflow NAME that
#    should answer inbound messages. Defaults to the "Concierge" agent.
# Long-polling is used, so NO public URL / webhook / hosting is required.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_TARGET=Concierge

# Persistence. SQLite by default — zero setup, file-based, fully local.
DATABASE_URL=sqlite:////app/data/yuno.db

# Runtime safety nets
GLOBAL_MAX_STEPS=25
REQUEST_TIMEOUT_SECONDS=120
