# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your keys:   cp .env.example .env
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# LLM provider. The platform supports BOTH Anthropic (direct API) and AWS
# Bedrock; the provider for each agent is derived from its model id, so you can
# mix them. Configure at least one. DEFAULT_MODEL decides what the seeded
# demo agents use, and DEFAULT_PROVIDER is informational.
# ----------------------------------------------------------------------------

# --- Option A: AWS Bedrock (bearer-token auth, no IAM key) ------------------
# Set the bearer token + region, and point DEFAULT_MODEL at a Bedrock model.
AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_REGION=us-west-2

# --- Option B: Anthropic direct API ----------------------------------------
# Get a key at https://console.anthropic.com/  (workspace must have credits).
ANTHROPIC_API_KEY=

# --- Pick the default model new/seeded agents run on -----------------------
# Bedrock (cheap, multimodal, verified working):  us.amazon.nova-lite-v1:0
#   higher quality / cleaner output:              us.amazon.nova-pro-v1:0
# Anthropic:                                       claude-haiku-4-5-20251001
DEFAULT_PROVIDER=bedrock
DEFAULT_MODEL=us.amazon.nova-lite-v1:0

# ----------------------------------------------------------------------------
# Telegram channel (OPTIONAL but required for the messaging-channel demo).
# 1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
# 2. Paste the token it gives you below.
# 3. (Optional) set TELEGRAM_DEFAULT_TARGET to an agent or workflow NAME that
#    should answer inbound messages. Defaults to the "Concierge" agent.
# Long-polling is used, so NO public URL / webhook / hosting is required.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_TARGET=Concierge

# Persistence. SQLite by default — zero setup, file-based, fully local.
DATABASE_URL=sqlite:////app/data/yuno.db

# Runtime safety nets
GLOBAL_MAX_STEPS=25
REQUEST_TIMEOUT_SECONDS=120
